# --- 비밀 정보: 절대 커밋 금지 ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
token*.json

# --- 생성물 (용량 크고 재생성 가능) ---
output/*
# 확정해서 실제로 쓰는 Pepper & Mint 이미지 (프로필, 키프레임)는 커밋
!output/pepper_mint/
*.mp4
# 실제로 게시한 완성본 영상만 커밋 (시험 영상은 output/test 에 둔다)
!output/pepper_mint/*.mp4
*.mov
*.wav
*.mp3
!assets/bgm/.gitkeep

# --- 상태 DB ---
*.db
*.sqlite
*.sqlite3

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- 에디터/OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
