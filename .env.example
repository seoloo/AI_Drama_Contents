# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 .gitignore 에 있어 커밋되지 않습니다)
#   PowerShell:  Copy-Item .env.example .env

# 1. 대본 생성 - Claude API  (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 2. 이미지 생성 - 사용할 모델을 정한 뒤 해당 키만 채우면 됩니다
GEMINI_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=

# 3. 음성 - ElevenLabs
ELEVENLABS_API_KEY=

# 6. 업로드 - Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=

# (선택) PATH 에 ffmpeg 가 없을 때 실행 파일 경로
FFMPEG_PATH=
